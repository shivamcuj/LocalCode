{
  "id": 1,
  "title": "Two Sum",
  "difficulty": "Easy",
  "method": "twoSum",
  "unordered": true,
  "timeout": 10,
  "tests": [
    {
      "input": {
        "nums": [
          2,
          7,
          11,
          15
        ],
        "target": 9
      },
      "expected": [
        0,
        1
      ]
    },
    {
      "input": {
        "nums": [
          3,
          2,
          4
        ],
        "target": 6
      },
      "expected": [
        1,
        2
      ]
    },
    {
      "input": {
        "nums": [
          3,
          3
        ],
        "target": 6
      },
      "expected": [
        0,
        1
      ],
      "hidden": true
    },
    {
      "input": {
        "nums": [
          -1,
          -2,
          -3,
          -4,
          -5
        ],
        "target": -8
      },
      "expected": [
        2,
        4
      ],
      "hidden": true
    }
  ],
  "types": {
    "nums": "int[]",
    "target": "int"
  },
  "returns": "int[]"
}